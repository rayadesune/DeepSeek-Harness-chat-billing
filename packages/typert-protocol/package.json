{
  "name": "@deepseek-ai/dsh-typert-protocol",
  "version": "0.1.6-alpha.1",
  "description": "Vendored Typert protocol declarations (npm 0.1.6-alpha.1) so the standalone typert generator can resolve Remote/TypertRemoteService from a registered workspace package.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  }
}
