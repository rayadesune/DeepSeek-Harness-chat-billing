{
  "name": "@rayadesu/dsh-client-ui-billing",
  "description": "Session-header DeepSeek account-balance and conversation-spend badge over the billing Remote",
  "version": "0.3.14",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "prepublishOnly": "node ../../scripts/verify-packages.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rayadesune/DeepSeek-Harness-chat-billing.git",
    "directory": "packages/ui-billing"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@rayadesu/dsh-llm-billing": "^0.3.14",
    "@deepseek-ai/dsh-client-locale": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-invariants": "^0.1.7-alpha.2",
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-api-remotes": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-session": "^0.1.7-alpha.2"
  },
  "devDependencies": {
    "@rayadesu/dsh-llm-billing": "^0.3.14",
    "@deepseek-ai/dsh-api-gateway": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-store": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-test-runtime": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-chat": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-dockkit": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-invariants": "^0.1.7-alpha.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "use-sync-external-store": "^1.2.0",
    "zustand": "~4.4.7",
    "immer": "^10.1.1",
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-api-remotes": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-session": "^0.1.7-alpha.2",
    "@shikijs/langs": "^4.3.1",
    "anser": "^2.3.5",
    "clsx": "^2.0.0",
    "diff": "^9.0.0",
    "katex": "^0.16.47",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
